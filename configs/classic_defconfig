# The classic image: i586, serial only, as little RAM as it can manage.
# docs/plan.md has the reasoning; this file is the decisions.

# CPU floor: any Pentium. The toolchain wrapper adds -march=i586 to every
# package, the agent included.
BR2_i386=y
BR2_x86_i586=y

# musl keeps binaries small; C++ is needed by smartmontools and ddrescue.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_18=y
BR2_OPTIMIZE_S=y

BR2_TARGET_GENERIC_HOSTNAME="rescue"
BR2_TARGET_GENERIC_ISSUE="devlink-rescue classic"
# No getty on the serial port: ttyS0 belongs to the agent (see inittab).
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DEVLINK_RESCUE_PATH)/board/classic/rootfs-overlay"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_DEVLINK_RESCUE_PATH)/board/classic/busybox.fragment"

# Kernel: the 6.18 LTS series, configured from a fragment on top of
# allnoconfig (board/classic/linux.defconfig is generated from it).
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.33"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_DEVLINK_RESCUE_PATH)/board/classic/linux.defconfig"
BR2_LINUX_KERNEL_BZIMAGE=y

# The userland is an initramfs, kept beside the kernel rather than built into
# it, so either can be replaced without the other. Buildroot leaves it
# uncompressed; post-image.sh compresses it with a dictionary the kernel can
# allocate on a small machine.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_NONE=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DEVLINK_RESCUE_PATH)/board/classic/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DEVLINK_RESCUE_PATH)/board/classic/post-image.sh"
# Tools in a squashfs over /usr, mounted at boot (post-fakeroot.sh says why).
# Merged /usr so that /usr is all of them; host squashfs to build it.
BR2_ROOTFS_MERGED_USR=y
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_DEVLINK_RESCUE_PATH)/board/classic/post-fakeroot.sh"
BR2_PACKAGE_HOST_SQUASHFS=y
# BR2_TARGET_ROOTFS_TAR is not set

# A BIOS-only El Torito ISO of the same kernel and initramfs, for loaders that
# boot ISOs (falcon's ISO library). post-image.sh builds it rather than
# Buildroot's iso9660 target, which packs its own copy of the initramfs
# instead of the xz one above. No EFI image: every machine this is for is
# BIOS-only.
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y
# The menu picks an entry by arrow key: isolinux 6.03 drops a label's APPEND
# when the label is typed at its boot: prompt instead.
BR2_TARGET_SYSLINUX_C32="menu.c32 libutil.c32 libcom32.c32"
BR2_PACKAGE_HOST_XORRISO=y

# The agent
BR2_PACKAGE_DEVLINK_AGENT=y

# The toolkit (docs/plan.md, "Toolkit"). lsusb and hwclock come from busybox;
# usbutils would bring udev with it.
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_MTOOLS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_DDRESCUE=y
# The full hdparm, not busybox's: -I reports far more.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_HDPARM=y
BR2_PACKAGE_SMARTMONTOOLS=y
# pciutils ships its own pci.ids; with zlib it installs and reads it gzipped.
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_DMIDECODE=y
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_CHNTPW=y
BR2_PACKAGE_MS_SYS=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_GDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_FATRESIZE=y
BR2_PACKAGE_CABEXTRACT=y
BR2_PACKAGE_TESTDISK=y
BR2_PACKAGE_FALCON_MKSTICK32=y
