# The build environment for devlink-rescue, for a machine with Docker and no
# toolchain of its own (binhost). Buildroot's host prerequisites on Debian
# trixie; Buildroot builds its own cross toolchain from these.
FROM debian:trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential bc bzip2 ca-certificates cpio file git gzip \
        libncurses-dev patch perl python3 rsync unzip wget xz-utils \
    && rm -rf /var/lib/apt/lists/*
